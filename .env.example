# Copy this to .env and fill in your values
# This file is for the local dev API server (server/index.ts)

OPENAI_API_KEY=sk-...

# Production URL for the add-in static files
# Used by webpack to rewrite localhost URLs in manifest.xml during production build
# Set this to your Vercel project URL after first deploy (e.g. https://paperpilot.vercel.app/)
PROD_URL=https://paperpilot.vercel.app/
